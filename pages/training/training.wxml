<view class="container training-page">
  <view class="hero">
    <view class="hero-title">训练记录</view>
    <view class="hero-subtitle">逐组记录重量和次数，复制上次训练，让健身房记录更顺手。</view>
  </view>

  <view class="card summary-card">
    <view class="section-title">今日训练完成总结</view>
    <view class="stat-grid">
      <view class="stat-item">
        <view class="stat-value">{{todaySummary.actionCount}}</view>
        <view class="stat-label">动作数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{todaySummary.setCount}}</view>
        <view class="stat-label">完成组数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{todaySummary.volume}}</view>
        <view class="stat-label">今日容量</view>
      </view>
    </view>
    <view class="compare-line">与上次训练容量对比：{{compareText}}</view>
  </view>

  <view class="card">
    <view class="section-title">新增训练</view>
    <view class="section-subtitle">每一组都可以单独记录重量和次数。</view>

    <view class="form-item">
      <view class="label">训练日期</view>
      <picker mode="date" value="{{record.date}}" bindchange="onDateChange">
        <view class="picker-box">{{record.date}}</view>
      </picker>
    </view>

    <view class="grid-2">
      <view class="form-item">
        <view class="label">训练部位</view>
        <picker range="{{bodyParts}}" value="{{bodyPartIndex}}" bindchange="onBodyPartChange">
          <view class="picker-box">{{record.bodyPart}}</view>
        </picker>
      </view>
      <view class="form-item">
        <view class="label">动作</view>
        <picker range="{{exerciseList}}" value="{{exerciseIndex}}" bindchange="onExerciseChange">
          <view class="picker-box">{{record.exercise}}</view>
        </picker>
      </view>
    </view>

    <view class="exercise-detail-entry" bindtouchstart="safeTapStart" bindtouchmove="safeTapMove" bindtap="handleSafeAction" data-action="openExerciseDetail" data-exercise="{{record.exercise}}" data-body-part="{{record.bodyPart}}">查看当前动作详情</view>

    <view class="last-record-card">
      <view class="last-title">上次同动作记录</view>
      <view wx:if="{{lastExerciseRecord}}" class="last-content">
        <view>{{lastExerciseRecord.date}} · {{lastExerciseRecord.volume}}kg</view>
        <view class="last-groups" wx:for="{{lastExerciseRecord.groups}}" wx:key="id">第{{index + 1}}组：{{item.weight}}kg × {{item.reps}}</view>
        <view class="copy-last-btn" bindtap="copyLastTraining">复制上次训练</view>
      </view>
      <view wx:else class="last-empty">还没有这个动作的历史记录。</view>
    </view>

    <view class="group-section">
      <view class="row between">
        <view class="section-title small-title">逐组记录</view>
        <view class="add-group-btn" bindtap="addGroup">添加一组</view>
      </view>

      <view wx:for="{{groups}}" wx:key="id" class="group-card">
        <view class="group-head">
          <view class="group-title">第 {{index + 1}} 组</view>
          <view class="group-actions">
            <view class="group-action" data-index="{{index}}" bindtap="copyPreviousGroup">复制上一组</view>
            <view class="group-delete" data-index="{{index}}" bindtap="deleteGroup">删除</view>
          </view>
        </view>
        <view class="grid-2 group-inputs">
          <view class="form-item compact-form">
            <view class="label">重量 kg</view>
            <input class="input" type="digit" value="{{item.weight}}" data-index="{{index}}" data-field="weight" bindinput="onGroupInput" placeholder="0" />
          </view>
          <view class="form-item compact-form">
            <view class="label">次数</view>
            <input class="input" type="number" value="{{item.reps}}" data-index="{{index}}" data-field="reps" bindinput="onGroupInput" placeholder="12" />
          </view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">休息时间</view>
      <input class="input" value="{{record.rest}}" data-field="rest" bindinput="onInput" placeholder="例如 90秒" />
    </view>

    <view class="timer-card">
      <view>
        <view class="timer-label">休息计时器</view>
        <view class="timer-time">{{restText}}</view>
      </view>
      <view class="timer-actions">
        <view class="timer-btn" bindtap="startRestTimer">{{restRunning ? '重新开始' : '开始计时'}}</view>
        <view class="timer-btn ghost" bindtap="skipRestTimer">跳过</view>
      </view>
    </view>

    <view class="form-item">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{record.note}}" data-field="note" bindinput="onInput" placeholder="例如：最后一组有点吃力，下次保持重量" />
    </view>

    <view class="volume-card">
      <view class="volume-label">预计训练容量</view>
      <view class="volume-value">{{volumePreview}}</view>
      <view class="volume-help">按每组重量 × 次数自动累计</view>
    </view>

    <button class="primary-btn save-btn" bindtouchstart="safeTapStart" bindtouchmove="safeTapMove" bindtap="handleSafeAction" data-action="saveRecord">保存训练记录</button>
  </view>

  <view class="card record-card">
    <view class="section-title">历史记录</view>
    <view wx:if="{{records.length === 0}}" class="empty empty-action">
      <view class="empty-title">暂无训练记录</view>
      <view class="empty-desc">完成第一个动作后，这里会展示你的训练历史和容量变化。</view>
      <navigator url="/pages/workout/workout" class="empty-btn">去开始今日训练</navigator>
    </view>
    <view wx:for="{{records}}" wx:key="id" class="record-item">
      <view class="row between">
        <view class="record-info">
          <view class="record-title-row">
            <view class="record-title">{{item.exercise}}</view>
            <view class="record-detail-link" bindtouchstart="safeTapStart" bindtouchmove="safeTapMove" bindtap="handleSafeAction" data-action="openExerciseDetail" data-exercise="{{item.exercise}}" data-body-part="{{item.bodyPart}}">详情</view>
          </view>
          <view class="record-meta">{{item.date}} · {{item.bodyPart}} · {{item.sets}}组</view>
        </view>
        <view class="record-volume">{{item.volume}}</view>
      </view>
      <view class="record-groups" wx:for="{{item.groups}}" wx:for-item="group" wx:key="id">第{{index + 1}}组：{{group.weight}}kg × {{group.reps}}</view>
      <view wx:if="{{item.note}}" class="record-note">{{item.note}}</view>
      <button class="delete-link" data-id="{{item.id}}" bindtouchstart="safeTapStart" bindtouchmove="safeTapMove" bindtap="handleSafeAction" data-action="deleteRecord">删除</button>
    </view>
  </view>
</view>
