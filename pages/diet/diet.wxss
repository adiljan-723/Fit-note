.diet-page {
  overflow-x: hidden;
}

.tag-wrap {
  margin-top: 16rpx;
}

.target-item {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f9fafb;
}

.target-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.target-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 900;
}

.target-value {
  color: #047857;
  font-size: 24rpx;
  font-weight: 900;
  text-align: right;
}

.progress-bar {
  height: 18rpx;
  margin-top: 16rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #10b981;
}

.target-status {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 23rpx;
  font-weight: 700;
}

.status-tip {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #047857;
  background: #ecfdf5;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
}

.sample-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f3f4f6;
}

.sample-title {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.sample-row {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.45;
}

.grid-3 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
}

.meal-input {
  min-height: 120rpx;
}

.water-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.water-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 18rpx;
  color: #047857;
  background: #d1fae5;
  font-size: 25rpx;
  font-weight: 900;
}

.save-btn {
  margin-top: 28rpx;
}

.empty {
  margin-top: 22rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.diet-record {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f3f4f6;
}

.record-date {
  font-size: 30rpx;
  font-weight: 900;
}

.record-kcal {
  color: #10b981;
  font-size: 26rpx;
  font-weight: 900;
}

.record-line {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.delete-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 56rpx;
  margin: 16rpx 0 0;
  padding: 0;
  line-height: normal;
  border-radius: 999rpx;
  color: #ef4444;
  background: #fee2e2;
  font-size: 24rpx;
}



.target-item,
.sample-box,
.diet-record {
  border: 1rpx solid #e5e7eb;
  background: #f9fafb;
}

.status-tip {
  border: 1rpx solid #bbf7d0;
  background: #ecfdf5;
}

.progress-fill,
.water-btn {
  background: #10b981;
}

.water-btn {
  color: #ffffff;
  box-shadow: 0 10rpx 20rpx rgba(16, 185, 129, 0.18);
}

.record-kcal {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
}

.delete-link {
  border: 1rpx solid #fecaca;
}


