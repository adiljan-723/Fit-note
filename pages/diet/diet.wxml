<view class="container diet-page">
  <view class="hero">
    <view class="hero-title">饮食记录</view>
    <view class="hero-subtitle">根据当前目标估算热量、蛋白质和饮水目标，让饮食记录更有方向。</view>
  </view>

  <view class="card target-card">
    <view class="section-title">今日饮食目标</view>
    <view class="section-subtitle">按当前体重和目标估算，仅作健身记录参考。</view>

    <view class="target-item">
      <view class="target-head">
        <view class="target-title">热量</view>
        <view class="target-value">{{targets.calories || 0}} / {{targets.calorieRange}} kcal</view>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width: {{targets.caloriePercent}}%;"></view></view>
      <view class="target-status">状态：{{status.calorieStatus}}</view>
    </view>

    <view class="target-item">
      <view class="target-head">
        <view class="target-title">蛋白质</view>
        <view class="target-value">{{targets.protein || 0}} / {{targets.proteinRange}} g</view>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width: {{targets.proteinPercent}}%;"></view></view>
      <view class="target-status">状态：{{status.proteinStatus}}</view>
    </view>

    <view class="target-item">
      <view class="target-head">
        <view class="target-title">饮水</view>
        <view class="target-value">{{targets.water || 0}} / {{targets.waterTarget}} ml</view>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width: {{targets.waterPercent}}%;"></view></view>
      <view class="target-status">状态：{{status.waterStatus}}</view>
    </view>
  </view>

  <view class="card status-card">
    <view class="section-title">今日饮食状态</view>
    <view wx:for="{{status.tips}}" wx:key="*this" class="status-tip">{{item}}</view>
  </view>

  <view class="card">
    <view class="section-title">{{guide.title}}</view>
    <view class="section-subtitle">{{guide.summary}}</view>
    <view class="tag-wrap">
      <view wx:for="{{guide.targets}}" wx:key="*this" class="tag">{{item}}</view>
    </view>

    <view class="sample-box">
      <view class="sample-title">一日参考搭配</view>
      <view class="sample-row">早餐：{{guide.sample.breakfast}}</view>
      <view class="sample-row">午餐：{{guide.sample.lunch}}</view>
      <view class="sample-row">晚餐：{{guide.sample.dinner}}</view>
      <view class="sample-row">加餐：{{guide.sample.snack}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">记录今天吃了什么</view>

    <view class="form-item">
      <view class="label">日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker-box">{{form.date}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label">早餐</view>
      <textarea class="textarea meal-input" value="{{form.breakfast}}" data-field="breakfast" bindinput="onInput" placeholder="例如：鸡蛋 2 个 + 牛奶 + 燕麦" />
    </view>

    <view class="form-item">
      <view class="label">午餐</view>
      <textarea class="textarea meal-input" value="{{form.lunch}}" data-field="lunch" bindinput="onInput" placeholder="例如：米饭 + 鸡胸肉 + 蔬菜" />
    </view>

    <view class="form-item">
      <view class="label">晚餐</view>
      <textarea class="textarea meal-input" value="{{form.dinner}}" data-field="dinner" bindinput="onInput" placeholder="例如：土豆 + 鱼肉 + 蔬菜" />
    </view>

    <view class="form-item">
      <view class="label">加餐</view>
      <input class="input" value="{{form.snack}}" data-field="snack" bindinput="onInput" placeholder="例如：香蕉 / 酸奶 / 蛋白粉" />
    </view>

    <view class="grid-3">
      <view class="form-item">
        <view class="label">饮水 ml</view>
        <input class="input" type="number" value="{{form.water}}" data-field="water" bindinput="onInput" placeholder="0" />
      </view>
      <view class="form-item">
        <view class="label">蛋白质 g</view>
        <input class="input" type="digit" value="{{form.protein}}" data-field="protein" bindinput="onInput" placeholder="估算" />
      </view>
      <view class="form-item">
        <view class="label">热量 kcal</view>
        <input class="input" type="number" value="{{form.calories}}" data-field="calories" bindinput="onInput" placeholder="估算" />
      </view>
    </view>

    <view class="water-actions">
      <view class="water-btn" data-amount="250" bindtap="addWater">+250ml</view>
      <view class="water-btn" data-amount="500" bindtap="addWater">+500ml</view>
      <view class="water-btn" data-amount="750" bindtap="addWater">+750ml</view>
    </view>

    <view class="form-item">
      <view class="label">备注</view>
      <textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="onInput" placeholder="例如：今天外食较多，晚餐减少油脂" />
    </view>

    <button class="primary-btn save-btn" bindtap="saveRecord">保存饮食记录</button>
  </view>

  <view class="card record-card">
    <view class="section-title">饮食历史</view>
    <view wx:if="{{records.length === 0}}" class="empty empty-action">
      <view class="empty-title">暂无饮食记录</view>
      <view class="empty-desc">记录第一天的饮食后，这里会展示你的热量、蛋白质和饮水情况。</view>
    </view>
    <view wx:for="{{records}}" wx:key="id" class="diet-record">
      <view class="row between">
        <view class="record-date">{{item.date}}</view>
        <view class="record-kcal">{{item.calories || '未估算'}} kcal</view>
      </view>
      <view class="record-line">早餐：{{item.breakfast || '未填写'}}</view>
      <view class="record-line">午餐：{{item.lunch || '未填写'}}</view>
      <view class="record-line">晚餐：{{item.dinner || '未填写'}}</view>
      <view class="record-line">饮水：{{item.water || 0}} ml · 蛋白质：{{item.protein || '未估算'}} g</view>
      <button class="delete-link" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
    </view>
  </view>
</view>
