.home-page {
  overflow-x: hidden;
}

.home-hero {
  position: relative;
  overflow: hidden;
}

.hero-kicker {
  margin-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-profile-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #d1fae5;
  background: rgba(16, 185, 129, 0.18);
  font-size: 22rpx;
  font-weight: 800;
}

.setup-btn,
.diet-btn,
.checkin-btn {
  margin-top: 24rpx;
}

.card-head {
  gap: 18rpx;
  align-items: flex-start;
}

.plan-badge,
.diet-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #064e3b;
  background: #a7f3d0;
  font-size: 23rpx;
  font-weight: 800;
}

.diet-badge {
  color: #92400e;
  background: #fef3c7;
}

.diet-badge.done {
  color: #064e3b;
  background: #a7f3d0;
}

.today-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 900;
  word-break: break-all;
}

.today-focus {
  margin-top: 8rpx;
  color: #10b981;
  font-size: 26rpx;
  font-weight: 800;
}

.exercise-list {
  margin-top: 8rpx;
}

.exercise-row {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
}

.exercise-main {
  min-width: 0;
}

.exercise-name {
  font-size: 28rpx;
  font-weight: 800;
  word-break: break-all;
}

.exercise-meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.today-hint {
  margin-top: 20rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.start-workout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #10b981;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.quick-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}


.action-btn {
  margin: 0;
}

.check-list {
  margin-top: 20rpx;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
}

.check-item.done {
  background: #ecfdf5;
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #d1d5db;
  font-size: 24rpx;
  font-weight: 900;
}

.check-item.done .check-dot {
  background: #10b981;
}

.check-text {
  min-width: 0;
}

.check-title {
  font-size: 27rpx;
  font-weight: 900;
}

.check-desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 23rpx;
}

.tag-wrap {
  margin-top: 16rpx;
}

.shortcut-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.shortcut-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 20rpx;
  color: #047857;
  background: #d1fae5;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.today-card {
  position: relative;
  overflow: hidden;
}



.plan-badge,
.diet-badge,
.hero-pill {
  
}

.exercise-row,
.check-item,
.shortcut-item {
  border: 1rpx solid #e5e7eb;
  background: #f9fafb;
}

.exercise-row {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.start-workout-btn {
  background: #f9fafb;
  box-shadow: 0 16rpx 30rpx rgba(16, 185, 129, 0.25);
}

.shortcut-item {
  color: #064e3b;
  background: #ecfdf5;
}

.today-progress-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #bbf7d0;
  border-radius: 22rpx;
  background: #ecfdf5;
}

.today-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #047857;
  font-size: 24rpx;
  font-weight: 900;
}

.today-progress-head text {
  color: #064e3b;
}

.today-progress-bar {
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #d1fae5;
  overflow: hidden;
}

.today-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #10b981;
}

.home-page .empty {
  margin-top: 18rpx;
}



