page {
  min-height: 100vh;
  background: #f9fafb;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.container {
  padding: 26rpx 24rpx 42rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  padding: 42rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 36rpx;
  color: #ffffff;
  background: #111827;
  box-shadow: 0 22rpx 50rpx rgba(15, 23, 42, 0.18);
  overflow: hidden;
}



.hero-title,
.hero-subtitle,
.hero-kicker,
.hero-profile-row,
.hero-tags,
.detail-tags {
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.65;
}

.card {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(229, 231, 235, 0.72);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.07);
  box-sizing: border-box;
}

.section-title {
  font-size: 33rpx;
  font-weight: 900;
  color: #111827;
  letter-spacing: 0.2rpx;
}

.section-subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.55;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.tag {
  display: flex;
  align-items: center;
  margin: 8rpx 12rpx 0 0;
  padding: 9rpx 18rpx;
  border: 1rpx solid #a7f3d0;
  border-radius: 999rpx;
  color: #047857;
  background: #ecfdf5;
  font-size: 22rpx;
  font-weight: 800;
}

.muted {
  color: #6b7280;
}

.primary-btn,
.secondary-btn,
.danger-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 90rpx;
  line-height: normal;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}



.primary-btn {
  color: #ffffff;
  background: #10b981;
  box-shadow: 0 14rpx 28rpx rgba(16, 185, 129, 0.24);
}

.secondary-btn {
  color: #047857;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
}

.danger-btn {
  color: #ffffff;
  background: #ef4444;
}

.form-item {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 25rpx;
  font-weight: 900;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  min-height: 86rpx;
  padding: 0 22rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 27rpx;
  box-sizing: border-box;
}

.picker-box {
  display: flex;
  align-items: center;
}

.textarea {
  min-height: 164rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.grid-2 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-item {
  padding: 24rpx 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  text-align: center;
  background: #f9fafb;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #111827;
}

.stat-label {
  margin-top: 7rpx;
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 700;
}

.empty {
  margin-top: 22rpx;
  padding: 28rpx 24rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 24rpx;
  color: #6b7280;
  background: #f9fafb;
  font-size: 25rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.empty-title {
  color: #111827;
  font-size: 29rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  height: 64rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #10b981;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
}





